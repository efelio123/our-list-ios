rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validCode(code) {
      return code.matches('^[0-9a-f]{32}$');
    }

    function listExists(code) {
      return exists(/databases/$(database)/documents/lists/$(code));
    }

    match /lists/{code} {
      // The random list ID is the invitation secret. Rules never permit listing lists.
      allow get: if signedIn() && validCode(code);
      allow list, create, update, delete: if false;

      match /items/{itemId} {
        allow get, list: if signedIn() && validCode(code) && listExists(code);
        allow create: if signedIn() && validCode(code) && listExists(code)
          && request.resource.data.keys().hasOnly(['title', 'completed', 'createdAt', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.completed == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signedIn() && validCode(code) && listExists(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed', 'updatedAt'])
          && request.resource.data.completed is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && validCode(code) && listExists(code);
      }
    }
  }
}
